# ==============================================================================
# SHAKHAM VAULT — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Service Environment ('production' or 'development')
ENVIRONMENT=production
SERVICE_NAME="Shakham Vault API"

# Database Configuration (PostgreSQL / Neon Serverless)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# Cryptographic Keys (MUST BE GENERATED SECURELY BEFORE DEPLOYING)
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate_a_cryptographically_secure_random_key_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AES-256-GCM Master Encryption Key (Base64-encoded 32-byte binary key)
# Generate with: python -c "from cryptography.hazmat.primitives.ciphers.aead import AESGCM; import base64; print(base64.b64encode(AESGCM.generate_key(256)).decode())"
AES_KEY_BASE64=your_base64_encoded_32_byte_aes_key_here

# CORS Allowed Origins (Comma-separated URLs where the frontend is hosted)
ALLOWED_ORIGINS=https://vault.yourdomain.com,http://localhost:5173

# Security & Rate Limiting Controls
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_PAYLOAD_SIZE_MB=2

# Initial Super Admin (Used only on clean startup if no admin exists)
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=ChangeMeImmediatelyAfterFirstLogin123!
INITIAL_ADMIN_NAME="Super Admin"
