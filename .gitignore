# ==============================================================================
# Git Ignore Rules — Shakham Vault
# ==============================================================================

# Dependencies
node_modules/
frontend/node_modules/
backend/venv/
venv/
ENV/
env/

# Environment Variables & Secrets (CRITICAL: Do not commit actual secrets!)
.env
.env.local
.env.*.local
frontend/.env
backend/.env
!.env.example
!frontend/.env.example
!backend/.env.example

# Build Outputs
dist/
frontend/dist/
build/
*.egg
*.egg-info/

# Python Cache & Bytecode
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
